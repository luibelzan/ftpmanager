# Base de datos
DATABASE_URL=postgresql+asyncpg://ftpuser:ftppass@localhost:5432/ftpmanager
DATABASE_URL_SYNC=postgresql://ftpuser:ftppass@localhost:5432/ftpmanager

# Seguridad
SECRET_KEY=cambia-esto-por-una-clave-segura-de-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Almacenamiento base (raíz donde viven las carpetas de clientes)
BASE_DOWNLOAD_PATH=C:/GD/Distribuidoras

# OpenVPN
OPENVPN_BIN=C:/Program Files/OpenVPN/bin/openvpn.exe
OPENVPN_CONFIG_DIR=C:/GD/config/vpn

# Telegram alertas
TELEGRAM_BOT_TOKEN=tu-token-aqui
TELEGRAM_CHAT_ID=tu-chat-id-aqui

# Entorno
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_DIR=C:/GD/logs/ftpmanager